# Production overrides for FC27AC — this file is NOT auto-loaded by Laravel.
# It documents exactly which values in .env must differ from local dev
# before this app goes live. Copy the relevant lines into the real
# production .env (or your host's env-var panel) at deploy time.
#
# Why these specifically: this app stores decrypted PSN/EA credentials
# in the browser and session-authenticates every sensitive action, so
# debug output and non-HTTPS session cookies are not cosmetic issues
# here — they're a direct path to leaking customer account passwords.

APP_ENV=production
APP_DEBUG=false
# Must be an https:// URL — the app requires it for the line below to
# have any effect (browsers silently drop "secure" cookies over http).
APP_URL=https://your-real-domain.example

# Cookie only ever sent over HTTPS. Leaving this unset (as in local dev)
# means the session cookie can be sent over plain HTTP if the app is
# ever reachable that way — a session-hijacking risk for a credentials app.
SESSION_SECURE_COOKIE=true

# Alerts (login-attack, TOTP-limit requests) are emailed to the tenant
# owner synchronously — see app/Notifications/CriticalAlertNotification.php.
# MAIL_MAILER=log only writes to the log file; nothing actually gets sent
# until this points at a real transport.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# If you later move CriticalAlertNotification (or anything else) onto
# ShouldQueue for throughput, a worker process must actually be running
# (`php artisan queue:work`) — QUEUE_CONNECTION=database alone does
# nothing without one.
# QUEUE_CONNECTION=database

# Daily DB dump + storage/app backup (spatie/laravel-backup — see
# config/backup.php and the schedule in routes/console.php).
# Requirements on the production server, none of which exist on this
# dev machine:
#   - `pg_dump` must be on PATH (installed alongside the postgresql
#     package; the Windows dev box this was built on doesn't have it,
#     which is fine — only the Linux server needs it)
#   - the server's crontab must run `php artisan schedule:run` every
#     minute (standard Laravel cron entry), or nothing here fires
#   - config/backup.php's local disk keeps backups on the SAME server
#     as the database — that protects against a bad deploy or a
#     dropped table, but not against losing the whole server. Add an
#     off-server disk (S3-compatible) to destination.disks before
#     this is a real disaster-recovery plan, not just an undo button.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# Upload size for the account-import Excel/CSV file (thousands of rows
# per batch) is raised via public/.user.ini, which ships with the app
# and applies automatically under PHP-FPM. If the production server
# runs Apache with mod_php instead, that file has NO effect — see the
# comment inside public/.user.ini for the mod_php alternative.
